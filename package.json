    "prebuild": "cp node_modules/bruit-kit/dist/sources/directional-sample-processor.js node_modules/bruit-kit/dist/audio/pitch-shift-processor.js node_modules/bruit-kit/dist/audio/sample-rate-reducer-processor.js public/worklets/",
